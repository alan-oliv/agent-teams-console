{
  "$schema": "movie-themes",
  "version": 1,
  "about": [
    "Movie themes for the agent-teams console. A theme renames agents and nothing else.",
    "It never renames a state, a verb, a metric, a task id or a file path — those are readouts.",
    "There is no UI for this file; it is the data the console reads. The picker lives in the",
    "config panel (gear) as 'movie theme'."
  ],
  "rules": {
    "castingIsByRoleSlot": "Map characters to role slots, never hashed from agent ids. The same role in the same film must always be the same character, so a theme is learnable.",
    "typeBadgeStays": "The agent-type badge stays beside the character name. 'Ariadne' + an 'architect' badge costs no information; replacing the type makes the wall unreadable.",
    "mentionMatchesEither": "@ filters on the character name AND the real slot name, and shows the slot name beside the character.",
    "overflowKeepsRealNames": "A team with more agents than the theme has role slots leaves the extras under their real names. Draw from 'spare' only if you need more named agents; never invent characters.",
    "oneMapping": "Feed every view from a single asChar(slot) mapping — wall, overview, rail, grid, panel chips, task owners, mailbox runs, comms thread pairs and bubbles, mention picker.",
    "teamNameIsDecoration": "The in-world team name is a chip on the session-picker trigger only. The real session id is untouched everywhere else. Measure the status bar in the LONGEST team-name state, not the default.",
    "noColours": "A theme sets names only, so any theme runs on any colour scheme. Per-film palettes are a separate feature."
  },
  "roleSlots": [
    { "slot": "lead", "agentType": "team-lead" },
    { "slot": "security", "agentType": "security-reviewer" },
    { "slot": "perf", "agentType": "general-purpose" },
    { "slot": "tests", "agentType": "test-runner" },
    { "slot": "architect", "agentType": "architect" },
    { "slot": "repro", "agentType": "general-purpose" }
  ],
  "legal": "Character names are protected IP. Fine for a personal or internal tool; not for anything shipped publicly.",
