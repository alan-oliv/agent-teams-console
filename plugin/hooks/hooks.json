{
  "description": "Everything the console observes, plus the launcher that starts it. The observation hooks POST each event to the console on its default port through a curl one-liner that always exits 0, so a console that isn't running costs nothing but a discarded connection refusal instead of a hook-error notice on every tool call. The launcher exits immediately unless a real team exists. Timeouts are in seconds.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 5 -X POST -H 'content-type: application/json' --data-binary @- http://127.0.0.1:4823/hook 2>/dev/null; exit 0",
            "timeout": 5
          }
        ],
        "matcher": "*"
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/console-launch.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 5 -X POST -H 'content-type: application/json' --data-binary @- http://127.0.0.1:4823/hook 2>/dev/null; exit 0",
            "timeout": 5
          }
        ],
        "matcher": "*"
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/console-launch.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 600 -X POST -H 'content-type: application/json' --data-binary @- http://127.0.0.1:4823/hook 2>/dev/null; exit 0",
            "timeout": 600
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 5 -X POST -H 'content-type: application/json' --data-binary @- http://127.0.0.1:4823/hook 2>/dev/null; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 5 -X POST -H 'content-type: application/json' --data-binary @- http://127.0.0.1:4823/hook 2>/dev/null; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 5 -X POST -H 'content-type: application/json' --data-binary @- http://127.0.0.1:4823/hook 2>/dev/null; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 5 -X POST -H 'content-type: application/json' --data-binary @- http://127.0.0.1:4823/hook 2>/dev/null; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -sS -m 5 -X POST -H 'content-type: application/json' --data-binary @- http://127.0.0.1:4823/hook 2>/dev/null; exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
