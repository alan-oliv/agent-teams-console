{
  "description": "Starts the agent teams console the moment a session spawns a real teammate, and prints its URL once — before the spawn when possible, falling back to just after it.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/console-launch.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/console-launch.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
